GEMINI_API_KEY=your-gemini-api-key-here
# Primary Gemini model (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
# Fallback Gemini model for transient provider errors (defaults to gemini-3.6-flash)
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# Thinking capacity/effort for models (defaults to medium)
GEMINI_CAPACITY=medium
SUPABASE_URL=your-supabase-project-url-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
# Base URL of the deployed Property News service (no trailing slash).
PROPERTY_NEWS_API_URL=https://property-news-pnsj.onrender.com