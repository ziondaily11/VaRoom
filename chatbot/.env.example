GEMINI_API_KEY=your-gemini-api-key-here
# Use a model available to the configured Gemini API key.
GEMINI_MODEL=gemini-3.6-flash
SUPABASE_URL=your-supabase-project-url-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
# Public base URL of the VaRoom API serving the R2-backed public-media proxy.
VAROOM_MEDIA_BASE_URL=https://your-varoom-api.example.com
# Base URL of the deployed Property News service (no trailing slash).
PROPERTY_NEWS_API_URL=https://property-news-pnsj.onrender.com