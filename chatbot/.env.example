# Which service writes Elie's replies: openrouter or gemini. Unset: OpenRouter
# when OPENROUTER_API_KEY is set, otherwise Gemini.
LLM_PROVIDER=
# OpenRouter key (openrouter.ai/keys). Set it on the host only, never in git.
OPENROUTER_API_KEY=
# Model IDs from openrouter.ai/models. OpenRouter tries the fallback itself when
# the primary fails; pick it from another company.
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_FALLBACK_MODEL=openai/gpt-5.6-luna
# Optional reasoning effort for models that think (none, minimal, low, ...).
OPENROUTER_REASONING=
GEMINI_API_KEY=your-gemini-api-key-here
# Primary Gemini model (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
# Fallback Gemini model for transient provider errors (defaults to gemini-3.6-flash)
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# Thinking capacity/effort for models (defaults to medium)
GEMINI_CAPACITY=medium
SUPABASE_URL=your-supabase-project-url-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
# Base URL of the deployed Property News service (no trailing slash).
PROPERTY_NEWS_API_URL=https://property-news-pnsj.onrender.com
# production on Render: drops the localhost CORS origins. Leave unset locally.
ENVIRONMENT=
# Shared secret (sent as X-Elie-Internal-Key) for POST /internal/reply/generate
# and GET /elie/diagnostics. Must match
# CHATBOT_INTERNAL_API_KEY on the Express server. Generate a long random value.
CHATBOT_INTERNAL_API_KEY=
