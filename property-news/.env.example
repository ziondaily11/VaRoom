# Keep this file local to the isolated property-news service. Do not add these
# values to the existing VaRoom .env files until Phase 2 is explicitly approved.
NEWS_ENVIRONMENT=development
NEWS_PORT=8010
NEWS_LOG_LEVEL=INFO

# Supabase is optional for unit tests and local demonstrations. The service-role
# key is server-only and must never be sent to a browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI provider. The rules-based analyser remains available when unset.
NEWS_AI_PROVIDER=rules
NEWS_AI_API_KEY=
NEWS_AI_MODEL=
NEWS_AI_BASE_URL=

# Fetching and service protection
NEWS_FETCH_TIMEOUT_SECONDS=20
NEWS_FETCH_MAX_BYTES=1500000
NEWS_FETCH_USER_AGENT=VaRoomPropertyNews/0.1 (+https://varoom.example)
NEWS_FETCH_RETRY_ATTEMPTS=3
NEWS_MIN_REQUEST_INTERVAL_SECONDS=1.0
NEWS_PUBLIC_RATE_LIMIT_PER_MINUTE=60

# Admin endpoints fail closed when this is blank. Use a long random value in a
# secret manager for isolated development/admin automation only.
NEWS_ADMIN_API_KEY=
