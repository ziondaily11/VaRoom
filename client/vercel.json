{
  "rewrites": [
    { "source": "/api/news", "destination": "https://varoom-1.onrender.com/api/news" },
    { "source": "/api/news/:path*", "destination": "https://varoom-1.onrender.com/api/news/:path*" },
    { "source": "/api/maps-config", "destination": "https://varoom-1.onrender.com/api/maps-config" },
    { "source": "/api/listings/:path*", "destination": "https://varoom-1.onrender.com/api/listings/:path*" },
    { "source": "/api/bookings/:path*", "destination": "https://varoom-1.onrender.com/api/bookings/:path*" },
    { "source": "/u/:username", "destination": "/profile-public.html" }
  ]
}
