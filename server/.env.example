
SUPABASE_URL=your-supabase-project-url-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Base URL of the separately deployed Phase 1 Property News service. This is
# server-only routing configuration, not a browser key. Example for local work:
# PROPERTY_NEWS_API_URL=http://localhost:8010
PROPERTY_NEWS_API_URL=

# Cloudflare R2 Configuration (required for video uploads)
# Get these from your Cloudflare R2 dashboard
R2_ACCOUNT_ID=your-r2-account-id
R2_BUCKET_NAME=your-r2-bucket-name
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# Video Upload Feature Flags
# During development, set VIDEO_PREMIUM_REQUIRED=false to test without premium
# Later, when monetizing, set VIDEO_PREMIUM_REQUIRED=true
VIDEO_UPLOADS_ENABLED=true
VIDEO_PREMIUM_REQUIRED=false

# Video Upload Constraints
VIDEO_MAX_FILE_SIZE_MB=500
VIDEO_MAX_COUNT_PER_PROPERTY=10
VIDEO_MAX_DURATION_SECONDS=3600

# Video Cleanup Configuration
# Grace period before orphaned objects are deleted (in hours)
VIDEO_CLEANUP_GRACE_PERIOD_HOURS=1
# Set to 'true' to run cleanup in dry-run mode (no deletions)
VIDEO_CLEANUP_DRY_RUN=false

