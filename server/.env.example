
SUPABASE_URL=your-supabase-project-url-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Admin-only session signing and invite email delivery
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
# Long random server-only secret used to bind Google account-information
# verification returns to the user who started them.
ACCOUNT_VERIFICATION_STATE_SECRET=replace-with-a-long-random-secret
PUBLIC_BASE_URL=http://localhost:3000
RESEND_API_KEY=
RESEND_FROM_EMAIL=VaRoom <onboarding@resend.dev>

# Base URL of the separately deployed Phase 1 Property News service. This is
# server-only routing configuration, not a browser key. Example for local work:
# PROPERTY_NEWS_API_URL=http://localhost:8010
PROPERTY_NEWS_API_URL=
# Must match NEWS_ADMIN_API_KEY configured on the Property News service.
PROPERTY_NEWS_ADMIN_API_KEY=

# Base URL of the Elie host-reply service (no trailing slash).
CHATBOT_API_URL=https://elie1-0.onrender.com

# Server-side chat message encryption. Generate a random 32-byte value and
# encode it as base64. Never expose or commit this key.
VA_ROOM_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-random-key
VA_ROOM_ENCRYPTION_ACTIVE_VERSION=1
# During rotation, keep old keys as VA_ROOM_ENCRYPTION_KEY_V1, etc., and set
# the active version to the new key version.

# Cloudflare R2 Configuration (required for video uploads)
# Get these from your Cloudflare R2 dashboard
R2_ACCOUNT_ID=your-r2-account-id
R2_BUCKET_NAME=your-r2-bucket-name
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# S3-compatible endpoint; signed URLs use https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# Video Upload Feature Flags
# During development, set VIDEO_PREMIUM_REQUIRED=false to test without premium
# Later, when monetizing, set VIDEO_PREMIUM_REQUIRED=true
VIDEO_UPLOADS_ENABLED=true
VIDEO_PREMIUM_REQUIRED=false

# Video Upload Constraints
# Video length restriction is enforced in seconds rather than file size.
VIDEO_MAX_FILE_SIZE_MB=100
VIDEO_MAX_COUNT_PER_PROPERTY=10
VIDEO_MAX_DURATION_SECONDS=60

# Video Cleanup Configuration
# Grace period before orphaned objects are deleted (in hours)
VIDEO_CLEANUP_GRACE_PERIOD_HOURS=1
# Set to 'true' to run cleanup in dry-run mode (no deletions)
VIDEO_CLEANUP_DRY_RUN=false
# Run orphan/stuck media cleanup periodically from the API service
VIDEO_CLEANUP_INTERVAL_HOURS=6

# Paystack host-plan billing. Keep PAYSTACK_SECRET_KEY and PAYSTACK_WEBHOOK_SECRET
# on Render only; PAYSTACK_PUBLIC_KEY is only needed if a future client SDK uses it.
PAYSTACK_MODE=test
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_test_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_replace_with_your_test_public_key
# Set this to the secret used to compute Paystack's x-paystack-signature.
# If omitted, the server uses PAYSTACK_SECRET_KEY, which is Paystack's standard behaviour.
PAYSTACK_WEBHOOK_SECRET=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_SESSION_SECRET=generate-a-long-random-secret
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=VaRoom <your-verified-email@example.com>
PUBLIC_BASE_URL=http://localhost:3000
CLIENT_BASE_URL=http://localhost:3000
